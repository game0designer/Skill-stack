import { initializeDatabase } from '../firestore/connection.js';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const { db } = initializeDatabase();

const collections = ['users', 'posts', 'comments', 'notifications', 'adminLogs'];

export const backupDatabase = async () => {
  const backupDir = path.join(__dirname, `backup_${Date.now()}`);
  fs.mkdirSync(backupDir, { recursive: true });
  
  console.log('💾 Starting database backup...');
  
  for (const collection of collections) {
    const snapshot = await db.collection(collection).get();
    const data = [];
    
    snapshot.forEach(doc => {
      data.push({ id: doc.id, ...doc.data() });
    });
    
    const filePath = path.join(backupDir, `${collection}.json`);
    fs.writeFileSync(filePath, JSON.stringify(data, null, 2));
    console.log(`✅ Backed up ${collection}: ${data.length} documents`);
  }
  
  console.log(`🎉 Backup completed: ${backupDir}`);
  return backupDir;
};

// Run backup if executed directly
if (import.meta.url === `file://${process.argv[1]}`) {
  backupDatabase();
}
