# Create firestore/connection.js
@"
import { initializeApp, cert } from 'firebase-admin/app';
import { getFirestore } from 'firebase-admin/firestore';
import { getStorage } from 'firebase-admin/storage';

// Initialize Firebase Admin SDK
let db;
let bucket;

export const initializeDatabase = () => {
  try {
    // Check if already initialized
    if (db) return { db, bucket };
    
    // Initialize with service account
    const app = initializeApp({
      credential: cert({
        projectId: process.env.FIREBASE_PROJECT_ID,
        privateKey: process.env.FIREBASE_PRIVATE_KEY?.replace(/\\\\n/g, '\\n'),
        clientEmail: process.env.FIREBASE_CLIENT_EMAIL,
      }),
      storageBucket: process.env.FIREBASE_STORAGE_BUCKET
    });
    
    db = getFirestore(app);
    bucket = getStorage(app).bucket();
    
    console.log('✅ Firebase Database connected');
    return { db, bucket };
  } catch (error) {
    console.error('❌ Database connection failed:', error);
    throw error;
  }
};

// Helper functions
export const getDB = () => {
  if (!db) initializeDatabase();
  return db;
};

export const getBucket = () => {
  if (!bucket) initializeDatabase();
  return bucket;
};

// Batch operations helper
export const batchWrite = async (operations) => {
  const db = getDB();
  const batch = db.batch();
  
  operations.forEach(op => {
    const ref = db.collection(op.collection).doc(op.id);
    if (op.type === 'set') {
      batch.set(ref, op.data);
    } else if (op.type === 'update') {
      batch.update(ref, op.data);
    } else if (op.type === 'delete') {
      batch.delete(ref);
    }
  });
  
  await batch.commit();
};

// Pagination helper
export const paginate = async (query, limit, lastDoc = null) => {
  let q = query.limit(limit);
  if (lastDoc) {
    q = q.startAfter(lastDoc);
  }
  
  const snapshot = await q.get();
  const docs = [];
  snapshot.forEach(doc => {
    docs.push({ id: doc.id, ...doc.data() });
  });
  
  const lastVisible = snapshot.docs[snapshot.docs.length - 1];
  const hasMore = snapshot.docs.length === limit;
  
  return {
    data: docs,
    lastDoc: lastVisible,
    hasMore
  };
};

// Transaction helper
export const runTransaction = async (callback) => {
  const db = getDB();
  return await db.runTransaction(callback);
};

export default { initializeDatabase, getDB, getBucket, batchWrite, paginate, runTransaction };
