# Create scripts/queries.js
@"
import { initializeDatabase, paginate } from '../firestore/connection.js';

const { db } = initializeDatabase();

// User queries
export const getUserByUsername = async (username) => {
  const snapshot = await db.collection('users')
    .where('username', '==', username)
    .limit(1)
    .get();
  
  if (snapshot.empty) return null;
  return { id: snapshot.docs[0].id, ...snapshot.docs[0].data() };
};

export const getTrendingUsers = async (limit = 10) => {
  const snapshot = await db.collection('users')
    .orderBy('stats.totalLikesReceived', 'desc')
    .limit(limit)
    .get();
  
  const users = [];
  snapshot.forEach(doc => {
    users.push({ id: doc.id, ...doc.data() });
  });
  return users;
};

// Post queries
export const getFeedPosts = async (limit = 20, lastDoc = null) => {
  let query = db.collection('posts')
    .where('status', '==', 'approved')
    .orderBy('createdAt', 'desc');
  
  return await paginate(query, limit, lastDoc);
};

export const getPostsByUser = async (userId, status = 'approved') => {
  const snapshot = await db.collection('posts')
    .where('authorId', '==', userId)
    .where('status', '==', status)
    .orderBy('createdAt', 'desc')
    .get();
  
  const posts = [];
  snapshot.forEach(doc => {
    posts.push({ id: doc.id, ...doc.data() });
  });
  return posts;
};

export const getTrendingPosts = async (limit = 10) => {
  const snapshot = await db.collection('posts')
    .where('status', '==', 'approved')
    .orderBy('stats.likesCount', 'desc')
    .limit(limit)
    .get();
  
  const posts = [];
  snapshot.forEach(doc => {
    posts.push({ id: doc.id, ...doc.data() });
  });
  return posts;
};

export const getPostsByTag = async (tag, limit = 20) => {
  const snapshot = await db.collection('posts')
    .where('tags', 'array-contains', tag)
    .where('status', '==', 'approved')
    .orderBy('createdAt', 'desc')
    .limit(limit)
    .get();
  
  const posts = [];
  snapshot.forEach(doc => {
    posts.push({ id: doc.id, ...doc.data() });
  });
  return posts;
};

// Comment queries
export const getCommentsByPost = async (postId, limit = 50) => {
  const snapshot = await db.collection('comments')
    .where('postId', '==', postId)
    .where('parentCommentId', '==', null)
    .orderBy('createdAt', 'asc')
    .limit(limit)
    .get();
  
  const comments = [];
  snapshot.forEach(doc => {
    comments.push({ id: doc.id, ...doc.data() });
  });
  return comments;
};

export const getReplies = async (commentId) => {
  const snapshot = await db.collection('comments')
    .where('parentCommentId', '==', commentId)
    .orderBy('createdAt', 'asc')
    .get();
  
  const replies = [];
  snapshot.forEach(doc => {
    replies.push({ id: doc.id, ...doc.data() });
  });
  return replies;
};

// Stats queries
export const getUserStats = async (userId) => {
  const posts = await getPostsByUser(userId);
  const totalLikes = posts.reduce((sum, post) => sum + (post.stats?.likesCount || 0), 0);
  const totalComments = posts.reduce((sum, post) => sum + (post.stats?.commentsCount || 0), 0);
  
  return {
    totalProjects: posts.length,
    totalLikesReceived: totalLikes,
    totalCommentsReceived: totalComments
  };
};

export default {
  getUserByUsername,
  getTrendingUsers,
  getFeedPosts,
  getPostsByUser,
  getTrendingPosts,
  getPostsByTag,
  getCommentsByPost,
  getReplies,
  getUserStats
};
