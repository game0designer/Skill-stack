# Create HR messaging collection schemas
@(
    "hrMessages.schema.js",
    "hrConversations.schema.js",
    "hrTickets.schema.js"
) | ForEach-Object {
    New-Item -ItemType File -Force -Path $_ | Out-Null
    Write-Host "Created: $_" -ForegroundColor Yellow
}

Write-Host "`n✅ HR messaging database schemas created" -ForegroundColor Green
```

