import { Routes, Route, Navigate } from 'react-router-dom';
import { useAuth } from './hooks/useAuth';

// Common pages
import LandingPage from './pages/common/LandingPage';
import ProfilePage from './pages/common/ProfilePage';
import ProjectPage from './pages/common/ProjectPage';
import SettingsPage from './pages/common/SettingsPage';
import NotFoundPage from './pages/common/NotFoundPage';

// Intern pages
import InternDashboard from './pages/intern/InternDashboard';
import FeedPage from './pages/intern/FeedPage';
import MyProjectsPage from './pages/intern/MyProjectsPage';
import CreateProjectPage from './pages/intern/CreateProjectPage';
import AIPage from './pages/intern/AIPage';
import TasksPage from './pages/intern/TasksPage';
import InternshipProgressPage from './pages/intern/InternshipProgressPage';
import NotificationsPage from './pages/intern/NotificationsPage';

// HR pages
import HRDashboard from './pages/hr/HRDashboard';
import InternManagement from './pages/hr/InternManagement';
import InternApplications from './pages/hr/InternApplications';
import InternEvaluation from './pages/hr/InternEvaluation';
import AttendanceTracking from './pages/hr/AttendanceTracking';
import PerformanceReviews from './pages/hr/PerformanceReviews';
import InternOnboarding from './pages/hr/InternOnboarding';
import InternOffboarding from './pages/hr/InternOffboarding';

// Admin pages
import AdminDashboard from './pages/admin/AdminDashboard';
import UserManagement from './pages/admin/UserManagement';
import PostManagement from './pages/admin/PostManagement';
import CommentModeration from './pages/admin/CommentModeration';
import ContentApproval from './pages/admin/ContentApproval';
import SystemLogs from './pages/admin/SystemLogs';
import AIControlPanel from './pages/admin/AIControlPanel';
import PlatformAnalytics from './pages/admin/PlatformAnalytics';

const PrivateRoute = ({ children, allowedRoles }) => {
  const { user, loading } = useAuth();
  if (loading) return <div>Loading...</div>;
  if (!user) return <Navigate to="/" />;
  if (allowedRoles && !allowedRoles.includes(user.role)) {
    return <Navigate to="/" />;
  }
  return children;
};

function AppRoutes() {
  return (
    <Routes>
      {/* Public Routes */}
      <Route path="/" element={<LandingPage />} />
      <Route path="/profile/:username" element={<ProfilePage />} />
      <Route path="/project/:id" element={<ProjectPage />} />
      
      {/* Intern Routes */}
      <Route path="/intern/dashboard" element={
        <PrivateRoute allowedRoles={['intern']}>
          <InternDashboard />
        </PrivateRoute>
      } />
       
      <Route path="/feed" element={
        <PrivateRoute allowedRoles={['intern']}>
          <FeedPage />
        </PrivateRoute>
      } />
      <Route path="/my-projects" element={
        <PrivateRoute allowedRoles={['intern']}>
          <MyProjectsPage />
        </PrivateRoute>
      } />
      <Route path="/create-project" element={
        <PrivateRoute allowedRoles={['intern']}>
          <CreateProjectPage />
        </PrivateRoute>
      } />
      <Route path="/ai-assistant" element={
        <PrivateRoute allowedRoles={['intern']}>
          <AIPage />
        </PrivateRoute>
      } />
      <Route path="/my-tasks" element={
        <PrivateRoute allowedRoles={['intern']}>
          <TasksPage />
        </PrivateRoute>
      } />
      <Route path="/internship-progress" element={
        <PrivateRoute allowedRoles={['intern']}>
          <InternshipProgressPage />
        </PrivateRoute>
      } />
      <Route path="/notifications" element={
        <PrivateRoute allowedRoles={['intern']}>
          <NotificationsPage />
        </PrivateRoute>
      } />
      
      {/* HR Routes */}
      <Route path="/hr/dashboard" element={
        <PrivateRoute allowedRoles={['hr', 'admin']}>
          <HRDashboard />
        </PrivateRoute>
      } />
      <Route path="/hr/interns" element={
        <PrivateRoute allowedRoles={['hr', 'admin']}>
          <InternManagement />
        </PrivateRoute>
      } />
      <Route path="/hr/applications" element={
        <PrivateRoute allowedRoles={['hr', 'admin']}>
          <InternApplications />
        </PrivateRoute>
      } />
      <Route path="/hr/evaluations" element={
        <PrivateRoute allowedRoles={['hr', 'admin']}>
          <InternEvaluation />
        </PrivateRoute>
      } />
      <Route path="/hr/attendance" element={
        <PrivateRoute allowedRoles={['hr', 'admin']}>
          <AttendanceTracking />
        </PrivateRoute>
      } />
      <Route path="/hr/reviews" element={
        <PrivateRoute allowedRoles={['hr', 'admin']}>
          <PerformanceReviews />
        </PrivateRoute>
      } />
      <Route path="/hr/onboard" element={
        <PrivateRoute allowedRoles={['hr', 'admin']}>
          <InternOnboarding />
        </PrivateRoute>
      } />
      <Route path="/hr/offboard" element={
        <PrivateRoute allowedRoles={['hr', 'admin']}>
          <InternOffboarding />
        </PrivateRoute>
      } />
      <Route path="/settings" element={
        <PrivateRoute allowedRoles={['intern', 'hr', 'admin']}>
          <SettingsPage />
        </PrivateRoute>
      } />
      
      {/* Super Admin Routes */}
      <Route path="/staff/console" element={
        <PrivateRoute allowedRoles={['admin']}>
          <AdminDashboard />
        </PrivateRoute>
      } />
      <Route path="/staff/users" element={
        <PrivateRoute allowedRoles={['admin']}>
          <UserManagement />
        </PrivateRoute>
      } />
      <Route path="/staff/posts" element={
        <PrivateRoute allowedRoles={['admin']}>
          <PostManagement />
        </PrivateRoute>
      } />
      <Route path="/staff/comments" element={
        <PrivateRoute allowedRoles={['admin']}>
          <CommentModeration />
        </PrivateRoute>
      } />
      <Route path="/staff/approvals" element={
        <PrivateRoute allowedRoles={['admin']}>
          <ContentApproval />
        </PrivateRoute>
      } />
      <Route path="/staff/logs" element={
        <PrivateRoute allowedRoles={['admin']}>
          <SystemLogs />
        </PrivateRoute>
      } />
      <Route path="/staff/ai-control" element={
        <PrivateRoute allowedRoles={['admin']}>
          <AIControlPanel />
        </PrivateRoute>
      } />
      <Route path="/staff/analytics" element={
        <PrivateRoute allowedRoles={['admin']}>
          <PlatformAnalytics />
        </PrivateRoute>
      } />
      
      {/* 404 */}
      <Route path="*" element={<NotFoundPage />} />
    </Routes>
  );
}

export default AppRoutes;
